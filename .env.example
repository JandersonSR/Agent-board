# TLDeck — copy to .env and fill in. NEVER commit .env.
# Empty fields = integration off (the deck shows "not configured").

# --- Server (always listens on 127.0.0.1) ---
AGENT_BOARD_PORT=
AGENT_BOARD_WEB_DEV_PORT=
AGENT_BOARD_APPROVAL_WAIT=
AGENT_BOARD_DIR=
AGENT_BOARD_TASK_RE=
AGENT_BOARD_NTFY=

# --- Language of the texts the deck writes by itself ---
# Agent answers (reviews, plans), what goes to GitHub (PENDING review, draft PR), alert titles and
# incident timelines: en (default) or pt-BR. The interface language is chosen on screen (L key).
CONTENT_LANG=

# --- Where the deck keeps its data ---
# auto (default): MongoDB if MONGO_URI is set; otherwise a local SQLite file (no server).
# sqlite | mongo | none
STORAGE=
# SQLite file (default: ~/.agent-board/data.db)
AGENT_BOARD_DB=

# --- MongoDB (optional): only the deck's own deck_* collections ---
# Use MONGO_URI or the NAME/USER/PASS/CLUSTERNAME set.
MONGO_URI=
MONGO_DATABASE_NAME=
MONGO_DATABASE_USER=
MONGO_DATABASE_PASS=
MONGO_DATABASE_CLUSTERNAME=
# One-off, read-only migration of the previous PR board's collection
MONGO_LEGACY_PR_DATABASE=
MONGO_LEGACY_PR_COLLECTION=

# --- GitHub (empty = uses `gh auth token`) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_LOGIN=
GITHUB_BOARD_REPO=
# login:name, comma-separated
TEAM_GITHUB_LOGINS=
# numbers of the org's GitHub Projects holding the deploy dates (e.g. 3,7) — needs the read:project scope
GITHUB_PROJECTS=
# regex for the name of the deploy date field in the Project (default: deploy)
DEPLOY_DATE_FIELD=
# track issues with a deploy from N days ago (default 7)
DEPLOY_LOOKBACK_DAYS=
# deploy branches (comma-separated): PRs open against them bring the issue into tracking
DEPLOY_BASE_BRANCHES=
# production branches (comma, trailing * as a wildcard): a merge into one = "In production" and the card leaves tracking
# (default: production,production-*)
DEPLOY_PROD_BRANCHES=

# --- Discord (READ-ONLY bot: View Channels + Read Message History + Message Content intent) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DAILY_CHANNEL_ID=
# label:channelId, comma-separated
DISCORD_WATCH_CHANNELS=
DISCORD_MY_USER_ID=
DISCORD_MY_ROLE_IDS=
# discordUserId:name, comma-separated (who should post the daily)
TEAM_DISCORD_MEMBERS=

# --- Team and queue ---
# team time zone in minutes (BRT = -180)
TEAM_TZ_OFFSET_MIN=
# holidays YYYY-MM-DD, comma-separated (business days)
HOLIDAYS=
# type priority order: groups by ";" and synonyms by "|" (default: ticket;bug;ajuste;tarefa)
QUEUE_TYPE_ORDER=
# window (days) of synced PRs for deploy tracking
PRS_LOOKBACK_DAYS=

# --- Agent context ---
# Feature RAGs (local clones with AGENTS.md + packs/_index.yaml): name=folder separated by ";"
FEAT_MAPS=
# which RAG applies to which target repo: name=glob|glob separated by ";" (empty = all)
FEAT_MAP_ROUTES=
# feature context token budget per prompt (default 6000)
FEAT_CONTEXT_TOKENS=
SKILLS_KIT_PATH=
# role=skill-name (roles: review, reviewInbox, daily, dailyDigest)
SKILL_NAMES=
WORKTREES_DIR=
# slug=path separated by semicolons
REPOS=
# folder with the repo clones (default: the folder above this project); repo "x" = <REPOS_ROOT>/x
REPOS_ROOT=
# models for background agents (default: sonnet)
AGENT_MODEL_REVIEW=
AGENT_MODEL_TASK=

# --- End-to-end tasks (issue → plan → implementation → draft PR) ---
# commands the agent may run in the worktree, comma-separated (empty = npm/pnpm/yarn test, lint, typecheck,
# build, vitest, dotnet build/test, mvn/gradle test, go test, pytest, rspec)
TASK_TEST_COMMANDS=
# independent verification the DECK runs after the agent: repo=command separated by ";"
# e.g. api=npm test;front=npm run typecheck   (without verification, the task is ready with the agent's tests only)
TASK_VERIFY=

# --- DORA metrics ---
# case-insensitive regex marking a delivery as a failure fix in the PR title, branch or labels
# default: \b(hot-?fix|rollback|revert|reverte|reverter|incidente|incident)\b
DORA_FAILURE_RE=

# --- Cost limits ---
MAX_CONCURRENT_SESSIONS=
SESSION_TIMEOUT_MIN=
MAX_DAILY_RUNS=
POLL_INTERVAL_MIN=

# --- Privacy: extra regexes to mask (separated by ;;) ---
MASK_EXTRA_PATTERNS=

# --- Real-time infra (READ-ONLY tokens; all optional) ---
# DigitalOcean: personal token with read scope. The tag limits the droplets read.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_TAG=
# Heroku: key of an account with view access; apps comma-separated.
HEROKU_API_KEY=
HEROKU_APPS=
# Azure: service principal with the Monitoring Reader role on the subscription.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# Grafana: service account token with the Viewer role.
GRAFANA_URL=
GRAFANA_TOKEN=
# Rules (defaults in the examples)
# INFRA_POLL_SEC=60
# INFRA_CPU_WARN=80
# INFRA_CPU_CRIT=90
# INFRA_MEM_CRIT=90
# INFRA_SUSTAIN_MIN=5
# INFRA_AUTO_INCIDENT=critical   # or off
# INFRA_PROD_RE=\b(prod|production|prd)\b
