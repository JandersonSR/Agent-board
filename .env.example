# Lead Deck — copie para .env e preencha. NUNCA commite o .env.
# Campos vazios = integração desligada (o painel mostra "não configurado").

# --- Servidor (escuta sempre em 127.0.0.1) ---
AGENT_BOARD_PORT=
AGENT_BOARD_WEB_DEV_PORT=
AGENT_BOARD_APPROVAL_WAIT=
AGENT_BOARD_DIR=
AGENT_BOARD_TASK_RE=
AGENT_BOARD_NTFY=

# --- Onde o painel guarda os dados ---
# auto (padrão): MongoDB se MONGO_URI estiver preenchido; senão, um arquivo SQLite local (sem servidor).
# sqlite | mongo | none
STORAGE=
# arquivo do SQLite (padrão: ~/.agent-board/data.db)
AGENT_BOARD_DB=

# --- MongoDB (opcional): só as coleções próprias painel_* ---
# Use MONGO_URI ou o conjunto NAME/USER/PASS/CLUSTERNAME.
MONGO_URI=
MONGO_DATABASE_NAME=
MONGO_DATABASE_USER=
MONGO_DATABASE_PASS=
MONGO_DATABASE_CLUSTERNAME=
# Migração única (somente leitura) da coleção do painel de PRs anterior
MONGO_LEGACY_PR_DATABASE=
MONGO_LEGACY_PR_COLLECTION=

# --- GitHub (vazio = usa `gh auth token`) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_LOGIN=
GITHUB_BOARD_REPO=
# login:nome separados por vírgula
TEAM_GITHUB_LOGINS=
# números dos GitHub Projects da org onde ficam as datas de deploy (ex.: 3,7) — exige escopo read:project
GITHUB_PROJECTS=
# regex do nome do campo de data de deploy no Project (padrão: deploy)
DEPLOY_DATE_FIELD=
# acompanhar issues com deploy a partir de N dias atrás (padrão 7)
DEPLOY_LOOKBACK_DAYS=
# branches de deploy (separadas por vírgula): PRs abertos para elas trazem a issue para o acompanhamento
DEPLOY_BASE_BRANCHES=

# --- Discord (bot SOMENTE LEITURA: View Channels + Read Message History + Message Content intent) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DAILY_CHANNEL_ID=
# rotulo:channelId separados por vírgula
DISCORD_WATCH_CHANNELS=
DISCORD_MY_USER_ID=
DISCORD_MY_ROLE_IDS=
# discordUserId:nome separados por vírgula (quem deve postar a daily)
TEAM_DISCORD_MEMBERS=

# --- Time e fila ---
# fuso do time em minutos (BRT = -180)
TEAM_TZ_OFFSET_MIN=
# feriados YYYY-MM-DD separados por vírgula (dias úteis)
HOLIDAYS=
# ordem de prioridade dos tipos: grupos por ";" e sinônimos por "|" (padrão: ticket;bug;ajuste;tarefa)
QUEUE_TYPE_ORDER=
# janela (dias) de PRs sincronizados para o acompanhamento de deploy
PRS_LOOKBACK_DAYS=

# --- Contexto dos agentes ---
# RAGs de features (clones locais com AGENTS.md + packs/_index.yaml): nome=pasta separados por ";"
FEAT_MAPS=
# qual RAG vale para qual repo alvo: nome=glob|glob separados por ";" (vazio = todos)
FEAT_MAP_ROUTES=
# orçamento de tokens de contexto de features por prompt (padrão 6000)
FEAT_CONTEXT_TOKENS=
SKILLS_KIT_PATH=
# papel=nome-da-skill (papéis: review, reviewInbox, daily, dailyDigest)
SKILL_NAMES=
WORKTREES_DIR=
# slug=caminho separados por ponto e vírgula
REPOS=
# pasta onde ficam os clones dos repos (padrão: a pasta acima deste projeto); repo "x" = <REPOS_ROOT>/x
REPOS_ROOT=
# modelos dos agentes em segundo plano (padrão: sonnet)
AGENT_MODEL_REVIEW=
AGENT_MODEL_TASK=

# --- Tarefas de ponta a ponta (issue → plano → implementação → PR em rascunho) ---
# comandos que o agente pode rodar na worktree, separados por vírgula (vazio = npm/pnpm/yarn test, lint, typecheck,
# build, vitest, dotnet build/test, mvn/gradle test, go test, pytest, rspec)
TASK_TEST_COMMANDS=
# verificação independente que o PAINEL roda depois do agente: repo=comando separados por ";"
# ex.: api=npm test;front=npm run typecheck   (sem verificação, a tarefa fica pronta só com os testes do agente)
TASK_VERIFY=

# --- Métricas DORA ---
# regex (sem diferenciar maiúsculas) que marca uma entrega como correção de falha no título, branch ou labels do PR
# padrão: \b(hot-?fix|rollback|revert|reverte|reverter|incidente|incident)\b
DORA_FAILURE_RE=

# --- Limites de custo ---
MAX_CONCURRENT_SESSIONS=
SESSION_TIMEOUT_MIN=
MAX_DAILY_RUNS=
POLL_INTERVAL_MIN=

# --- Privacidade: regex extras para mascarar (separadas por ;;) ---
MASK_EXTRA_PATTERNS=
